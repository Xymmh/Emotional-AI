# 复制本文件为 .env 并填入本地开发配置（.env 不会提交到仓库）

# 火山方舟 API Key：https://console.volcengine.com/ark/region:ark+cn-beijing/apikey
ARK_API_KEY=
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3

# 开发态侧车访问令牌，可任意填写一个足够随机的字符串
SIDECAR_TOKEN=dev-token

# 模型 ID（在方舟控制台开通后填入对应版本）
CHAT_MODEL=doubao-seed-2-0-lite-260428
ANALYST_MODEL=doubao-seed-2-0-lite-260428
ROLEPLAY_MODEL_LITE=doubao-seed-2-0-lite-260428
ROLEPLAY_MODEL_CHARACTER=doubao-seed-character
EMBEDDING_MODEL=doubao-embedding-vision-251215
EMBEDDING_DIM=1024
